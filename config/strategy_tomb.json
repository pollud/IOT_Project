{
  "room_id": "room_tomb",
  "name": "Pharaoh's Hieroglyph Tomb",
  "version": "1.0",
  "initial_state": "entrance",
  "states": {
    "entrance": {
      "on_enter": [
        {"action": "setLights", "color": "yellow"},
        {"action": "publishStatus", "status": "active"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "hieroglyph_wheel",
          "interaction_type": "keypad",
          "value": "ANKH_EYE",
          "target_state": "wheel_aligned"
        }
      ]
    },
    "wheel_aligned": {
      "on_enter": [
        {"action": "playAudio", "track": "stone_door.mp3"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "mummy_chest",
          "interaction_type": "rfid",
          "value": "golden_scarab",
          "target_state": "tomb_opened"
        }
      ]
    },
    "tomb_opened": {
      "on_enter": [
        {"action": "unlockDoor", "target": "main_exit"},
        {"action": "publishStatus", "status": "completed"}
      ],
      "transitions": []
    }
  }
}
