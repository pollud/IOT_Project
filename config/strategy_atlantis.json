{
  "room_id": "room_atlantis",
  "name": "Atlantis Prism Temple",
  "version": "1.0",
  "initial_state": "entrance",
  "states": {
    "entrance": {
      "on_enter": [
        {"action": "setLights", "color": "blue"},
        {"action": "publishStatus", "status": "active"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "hydro_valve",
          "interaction_type": "button",
          "value": "valve_opened",
          "target_state": "water_aligned"
        }
      ]
    },
    "water_aligned": {
      "on_enter": [
        {"action": "playAudio", "track": "waterfall.mp3"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "crystal_pedestal",
          "interaction_type": "rfid",
          "value": "trident_gem",
          "target_state": "temple_sealed"
        }
      ]
    },
    "temple_sealed": {
      "on_enter": [
        {"action": "unlockDoor", "target": "main_exit"},
        {"action": "publishStatus", "status": "completed"}
      ],
      "transitions": []
    }
  }
}
