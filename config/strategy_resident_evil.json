{
  "room_id": "room1",
  "version": "re_mansion_v1",
  "initial_state": "mansion_hall",
  "states": {
    "mansion_hall": {
      "on_enter": [
        {
          "action": "publishStatus",
          "status": "started"
        }
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "typewriter",
          "interaction_type": "button",
          "value": "pressed",
          "target_state": "save_room"
        }
      ]
    },
    "save_room": {
      "on_enter": [
        {
          "action": "playAudio",
          "track": "save_theme.mp3"
        }
      ],
      "transitions": [
        {
          "trigger": "time",
          "duration_seconds": 2,
          "target_state": "hallway"
        }
      ]
    },
    "hallway": {
      "on_enter": [],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "crest_socket",
          "interaction_type": "rfid",
          "value": "sun_crest",
          "target_state": "courtyard"
        }
      ]
    },
    "courtyard": {
      "on_enter": [],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "crank_hole",
          "interaction_type": "rotary",
          "value": "turned",
          "target_state": "game_cleared"
        }
      ]
    },
    "game_cleared": {
      "on_enter": [
        {
          "action": "publishStatus",
          "status": "completed"
        }
      ],
      "transitions": []
    }
  }
}