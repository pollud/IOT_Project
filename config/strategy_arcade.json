{
  "room_id": "room_arcade",
  "name": "VR Arcade High Score Arena",
  "version": "1.0",
  "initial_state": "entrance",
  "states": {
    "entrance": {
      "on_enter": [
        {"action": "setLights", "color": "neon_blue"},
        {"action": "publishStatus", "status": "active"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "target_node",
          "interaction_type": "capacitive",
          "value": "target_hit_100",
          "target_state": "boss_unlocked"
        }
      ]
    },
    "boss_unlocked": {
      "on_enter": [
        {"action": "playAudio", "track": "boss_battle.mp3"},
        {"action": "setLights", "color": "neon_pink"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "score_tower",
          "interaction_type": "button",
          "value": "high_score_achieved",
          "target_state": "champion_cleared"
        }
      ]
    },
    "champion_cleared": {
      "on_enter": [
        {"action": "unlockDoor", "target": "main_exit"},
        {"action": "publishStatus", "status": "completed"}
      ],
      "transitions": []
    }
  }
}
