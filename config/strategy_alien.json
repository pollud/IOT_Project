{
  "room_id": "room_alien",
  "name": "Alien Isolation Airlock",
  "version": "1.0",
  "initial_state": "entrance",
  "states": {
    "entrance": {
      "on_enter": [
        {"action": "setLights", "color": "red"},
        {"action": "publishStatus", "status": "active"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "geiger_counter",
          "interaction_type": "capacitive",
          "value": "radiation_calibrated",
          "target_state": "radiation_cleared"
        }
      ]
    },
    "radiation_cleared": {
      "on_enter": [
        {"action": "playAudio", "track": "siren_alert.mp3"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "airlock_switch",
          "interaction_type": "button",
          "value": "airlock_depressurized",
          "target_state": "escape_pod_ready"
        }
      ]
    },
    "escape_pod_ready": {
      "on_enter": [
        {"action": "unlockDoor", "target": "main_exit"},
        {"action": "publishStatus", "status": "completed"}
      ],
      "transitions": []
    }
  }
}
