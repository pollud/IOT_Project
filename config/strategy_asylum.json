{
  "room_id": "room_asylum",
  "name": "Asylum Sanity Lock",
  "version": "1.0",
  "initial_state": "entrance",
  "states": {
    "entrance": {
      "on_enter": [
        {"action": "setLights", "color": "strobe_white"},
        {"action": "publishStatus", "status": "active"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "voltage_dial",
          "interaction_type": "keypad",
          "value": "220V",
          "target_state": "grid_stabilized"
        }
      ]
    },
    "grid_stabilized": {
      "on_enter": [
        {"action": "playAudio", "track": "flatline.mp3"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "padded_door",
          "interaction_type": "rfid",
          "value": "doctor_keycard",
          "target_state": "patient_escaped"
        }
      ]
    },
    "patient_escaped": {
      "on_enter": [
        {"action": "unlockDoor", "target": "main_exit"},
        {"action": "publishStatus", "status": "completed"}
      ],
      "transitions": []
    }
  }
}
