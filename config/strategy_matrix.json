{
  "room_id": "room_matrix",
  "name": "The Matrix Code Injection",
  "version": "1.0",
  "initial_state": "entrance",
  "states": {
    "entrance": {
      "on_enter": [
        {"action": "setLights", "color": "green"},
        {"action": "publishStatus", "status": "active"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "phone_booth",
          "interaction_type": "button",
          "value": "dial_operator",
          "target_state": "operator_connected"
        }
      ]
    },
    "operator_connected": {
      "on_enter": [
        {"action": "playAudio", "track": "neo_wake_up.mp3"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "laser_grid",
          "interaction_type": "capacitive",
          "value": "grid_disabled",
          "target_state": "mainframes_accessible"
        }
      ]
    },
    "mainframes_accessible": {
      "on_enter": [
        {"action": "unlockDoor", "target": "main_exit"},
        {"action": "publishStatus", "status": "completed"}
      ],
      "transitions": []
    }
  }
}
