{
  "room_id": "room_sherlock",
  "name": "Sherlock Cryptogram Study",
  "version": "1.0",
  "initial_state": "entrance",
  "states": {
    "entrance": {
      "on_enter": [
        {"action": "setLights", "color": "warm_yellow"},
        {"action": "publishStatus", "status": "active"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "bookcase_switch",
          "interaction_type": "button",
          "value": "book_pulled",
          "target_state": "secret_study_revealed"
        }
      ]
    },
    "secret_study_revealed": {
      "on_enter": [
        {"action": "playAudio", "track": "violin_tune.mp3"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "typewriter",
          "interaction_type": "keypad",
          "value": "ELEMENTARY",
          "target_state": "case_solved"
        }
      ]
    },
    "case_solved": {
      "on_enter": [
        {"action": "unlockDoor", "target": "main_exit"},
        {"action": "publishStatus", "status": "completed"}
      ],
      "transitions": []
    }
  }
}
