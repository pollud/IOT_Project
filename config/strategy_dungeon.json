{
  "room_id": "room_dungeon",
  "name": "Dungeon Altar Escape",
  "version": "1.0",
  "initial_state": "entrance",
  "states": {
    "entrance": {
      "on_enter": [
        {"action": "setLights", "color": "orange"},
        {"action": "publishStatus", "status": "active"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "potion_stand",
          "interaction_type": "rfid",
          "value": "blue_elixir",
          "target_state": "potion_mixed"
        }
      ]
    },
    "potion_mixed": {
      "on_enter": [
        {"action": "playAudio", "track": "magic_chime.mp3"}
      ],
      "transitions": [
        {
          "trigger": "event",
          "event_type": "PropEvent",
          "prop_id": "rune_altar",
          "interaction_type": "button",
          "value": "rune_activated",
          "target_state": "gate_unlocked"
        }
      ]
    },
    "gate_unlocked": {
      "on_enter": [
        {"action": "unlockDoor", "target": "main_exit"},
        {"action": "publishStatus", "status": "completed"}
      ],
      "transitions": []
    }
  }
}
